ANTHROPIC_API_KEY=

# Optional, shown with their defaults.
# PORT=3000
# DATABASE_PATH=data/asked-before.sqlite
# The address people reach the app at. Unset, a request's own origin counts as the app's; https makes the session cookie Secure.
# PUBLIC_URL=
# Model requests one account may make per UTC day.
# DAILY_MODEL_REQUESTS=300
# Phrasings a sort sends the model at once, beside up to as many of the project's most recent unsorted ones.
# SORT_BATCH_SIZE=300
