ANTHROPIC_API_KEY=

# The key is the only setting .env holds: `wrangler dev` reads it from here
# (or from your shell), and so do the check scripts. The app's other
# settings, PUBLIC_URL, SITE_DAILY_MODEL_REQUESTS, SITE_DAILY_PHRASINGS, and
# SORT_BATCH_SIZE, are vars in wrangler.jsonc. Don't make a .dev.vars:
# Wrangler would read it instead of this file.
