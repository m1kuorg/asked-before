// The pages, in the browser: React with the automatic JSX runtime, and `@/`
// for src/ (the shadcn components' alias, components.json). Bun's types are
// here too, for the macros that run when the pages are bundled (see
// tsconfig.base.json). The paths replace the base's, so the SDK's is repeated,
// relative to this file.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@asked-before/sdk": ["../packages/sdk/src/index.ts"]
    }
  },
  "include": ["."]
}
