// Asked Before on Cloudflare Workers (ADR 0005). One Worker answers the API
// under /api/; every other path is a static asset that `bun run build:pages`
// writes to dist/ first. `bun run dev` runs it all locally, with no
// Cloudflare account; the README's "Deploy it" says how to deploy it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asked-before",
  "main": "worker/index.ts",
  // Node.js's APIs (node:crypto) are on by default from 2026-08-04.
  "compatibility_date": "2026-10-12",
  // Served at https://asked-before.m1kuorg.workers.dev, with no per-version preview addresses.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // The remote database, made with `wrangler d1 create asked-before --binding DB`.
  // Locally the id isn't used: `bun run dev` and the checks keep their own.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asked-before",
      "database_id": "c3ffeaed-2700-4640-933e-4a41e6615718",
      "migrations_dir": "migrations"
    }
  ],
  // Each shelf's sort, one Durable Object per shelf, named by its id (worker/sorter.ts).
  "durable_objects": { "bindings": [{ "name": "SORTER", "class_name": "Sorter" }] },
  "exports": { "Sorter": { "type": "durable-object", "storage": "sqlite" } },
  // Every five minutes, the cron starts again each shelf's sort that has
  // stalled, with an upload waiting or sorting and no progress in ten
  // minutes (server/sort.ts's resumeStalledSorts). Locally, nothing runs it
  // on its own: `curl "<the app's address>/cdn-cgi/local/scheduled"` does.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Settings, as strings; server/config.ts checks them. PUBLIC_URL is the
  // address people reach the deployed app at: unset, a request's own origin
  // counts as the app's, and an https one makes the session cookie Secure.
  // `bun run dev` and the checks always run with it unset, on localhost.
  "vars": {
    "PUBLIC_URL": "https://asked-before.m1kuorg.workers.dev",
    "DAILY_MODEL_REQUESTS": "10",
    "SORT_BATCH_SIZE": "300"
  },
  // A Worker secret in production; locally, read from .env or the shell.
  "secrets": { "required": ["ANTHROPIC_API_KEY"] },
  // Logs carry only each request's method, path, status, and duration, and stay in the terminal.
  "observability": { "enabled": false, "issues": { "enabled": false } }
}
