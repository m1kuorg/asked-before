{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun"],
    // The repo runs the SDK from its sources, so nothing in it waits on the SDK's build (packages/sdk/dist).
    "paths": { "@asked-before/sdk": ["./packages/sdk/src/index.ts"] }
  },
  "exclude": ["node_modules", ".worktrees", ".claude", ".agents", "agent", "plugins/*/dist", "packages/*/dist"]
}
