// The Bun scripts and the packages, with Bun's types (see tsconfig.base.json).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"]
  },
  "include": ["scripts", "packages"],
  // check:docs reads the route table and the sort's window from server/,
  // whose sort isn't on Workers yet; it comes back with m1kuorg/basics#64.
  "exclude": ["node_modules", "packages/*/dist", "scripts/check-docs.ts"]
}
