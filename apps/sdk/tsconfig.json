// The SDK in the repo, its examples and fixtures included, with Bun's types,
// which the web app installs. It shares the web app's base
// (../web/tsconfig.base.json), whose paths take the SDK from its sources, so
// the examples run with no build. `bun run typecheck` checks it with the web
// app's scripts (../web/tsconfig.json); its build is tsconfig.build.json.
{
  "extends": "../web/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "typeRoots": ["../web/node_modules/@types"],
    "types": ["bun"]
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
