{
  "name": "asked-before",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:pages && wrangler d1 migrations apply DB --local < /dev/null && wrangler dev --var PUBLIC_URL:",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker && tsc --noEmit -p src",
    "journey": "bun run scripts/journey.ts",
    "check:smoke": "bun run scripts/check-smoke.ts",
    "check:accounts": "bun run scripts/check-accounts.ts",
    "check:passwords": "bun run scripts/check-passwords.ts",
    "check:caps": "bun run scripts/check-caps.ts",
    "check:fresh-accounts": "bun run scripts/check-fresh-accounts.ts",
    "check:shell": "bun run scripts/check-shell.ts",
    "check:readers": "bun run scripts/check-readers.ts",
    "check:uploads": "bun run scripts/check-uploads.ts",
    "check:upload-page": "bun run scripts/check-upload-page.ts",
    "check:settings": "bun run scripts/check-settings.ts",
    "check:landing": "bun run scripts/check-landing.ts",
    "check:key": "bun run scripts/check-answer-key.ts",
    "check:styles": "bun run scripts/check-styles.ts",
    "check:sort": "bun run scripts/check-sort.ts",
    "check:sort-rules": "bun run scripts/check-sort-rules.ts",
    "check:sort-page": "bun run scripts/check-sort-page.ts",
    "check:shelf": "bun run scripts/check-shelf.ts",
    "check:reps": "bun run scripts/check-reps.ts",
    "check:rep-rules": "bun run scripts/check-rep-rules.ts",
    "check:card-page": "bun run scripts/check-card-page.ts",
    "check:captures": "bun run scripts/check-captures.ts",
    "check:capture-sort": "bun run scripts/check-capture-sort.ts",
    "check:mcp": "bun run scripts/check-mcp.ts",
    "check:data": "bun run scripts/check-data.ts",
    "check:desk": "bun run scripts/check-desk.ts",
    "check:plugin": "bun run scripts/check-plugin.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "check:sdk": "bun run scripts/check-sdk.ts",
    "check:migrations": "bun run scripts/check-migrations.ts",
    "build:pages": "bun run scripts/build-pages.ts",
    "build:plugin": "bun run scripts/build-plugin.ts",
    "build:sdk": "bun run --cwd packages/sdk build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@asked-before/sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
